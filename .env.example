# Copia questo file in `.env` e riempilo. `.env` e' escluso da git: il token non
# finisce mai nel repository.
#
#   cp .env.example .env
#   npm run pubblica -- --verifica     # controlla senza toccare nulla
#   npm run pubblica                   # crea il repo e fa il push

# ---------------------------------------------------------------- necessari
# Token GitHub. Consigliato un fine-grained token con il minimo indispensabile:
#   github.com/settings/personal-access-tokens/new
#   Repository access: All repositories (serve per crearne uno nuovo)
#   Permissions → Repository → Administration: Read and write   (crea il repo)
#                            → Contents:       Read and write   (fa il push)
# In alternativa un token classic con il solo scope `repo`.
# E' revocabile in qualsiasi momento dalle impostazioni GitHub.
GITHUB_TOKEN=

# Il tuo nome utente GitHub (non l'email).
GITHUB_USER=

# ---------------------------------------------------------------- opzionali
# Nome del repository da creare. Default: serata-giochi
GITHUB_REPO=serata-giochi

# Repository privato? true (default) o false.
# Consigliato true: il repo contiene brani e immagini di terzi.
GITHUB_PRIVATE=true

# Descrizione mostrata su GitHub.
GITHUB_DESC=Webapp per condurre e gestire la serata giochi

# Se il repo deve stare in un'organizzazione invece che sul tuo account,
# metti qui il nome dell'organizzazione. Lascia vuoto per l'account personale.
GITHUB_ORG=

# Identita' usata per i commit di questo repository. Se le lasci vuote resta
# quella globale di git (attualmente: Filippo Spazzali / spazzalifilippo@icloud.com).
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
